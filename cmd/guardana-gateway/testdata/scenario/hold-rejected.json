{
  "kind": "agent-scenario/v1alpha1",
  "about": "An update is held, an approver rejects it, and the retry is blocked on the held trail.",
  "plane": {"mode": "APPROVE", "bundle": {"id": "scenario-fixture"}},
  "steps": [
    {"call": {
      "tool": "update_order",
      "args": {"id": "ord-20"},
      "answer": {"kind": "pending", "codes": ["APPROVAL_PENDING"]},
      "decided": {"verdict": "ALLOW", "codes": ["RULE_ALLOW"], "obligations": []},
      "trail": {"request": "new", "kinds": ["ACTION_PROPOSED", "POLICY_DECIDED", "APPROVAL_REQUESTED"]}
    }},
    {"reject": {"step": 0, "approver": "bob"}},
    {"call": {
      "tool": "update_order",
      "args": {"id": "ord-20"},
      "answer": {"kind": "blocked", "codes": ["APPROVAL_REJECTED"]},
      "decided": {"verdict": "ALLOW", "codes": ["RULE_ALLOW"], "obligations": []},
      "trail": {"request": "step[0]", "kinds": ["ACTION_PROPOSED", "POLICY_DECIDED", "APPROVAL_REQUESTED", "APPROVAL_DECIDED", "ACTION_BLOCKED"]}
    }},
    {"call": {
      "tool": "read_order",
      "args": {"id": "ord-20"},
      "answer": {"kind": "result", "codes": []},
      "decided": {"verdict": "ALLOW", "codes": ["RULE_ALLOW"], "obligations": []},
      "trail": {"request": "new", "kinds": ["ACTION_PROPOSED", "POLICY_DECIDED", "ACTION_STARTED", "ACTION_COMPLETED"]}
    }}
  ]
}
