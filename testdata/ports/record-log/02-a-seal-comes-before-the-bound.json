{
  "rule": "lines that would take a live segment holding a line past its byte bound seal it first",
  "segment_bytes": 8,
  "max_bytes": 64,
  "steps": [
    {"append": ["aaa"]},
    {"append": ["bbbb"]},
    {"locate": "aaa", "state": "sealed"},
    {"locate": "bbbb", "state": "live"}
  ],
  "negative_control": [
    {"append": ["aaa"]},
    {"append": ["bbb"]},
    {"locate": "aaa", "state": "live"},
    {"locate": "bbb", "state": "unknown"}
  ]
}
