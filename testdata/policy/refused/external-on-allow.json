{
  "apiVersion": "agent-policy/v1alpha1",
  "bundle": {"id": "payments", "version": "2026-09-23.1", "serial": 1, "maxStaleSeconds": 300},
  "rules": [
    {"id": "refunds-vetoed", "effect": "DENY", "when": {"action": {"name": ["refund"]}, "external": {"denies": true}}},
    {"id": "refunds-granted", "effect": "ALLOW", "when": {"action": {"name": ["refund"]}, "external": {"denies": true}}}
  ]
}
